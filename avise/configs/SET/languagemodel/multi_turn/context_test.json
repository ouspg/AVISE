{
  "description": "Memory test configuration - tests multi-turn conversation context retention",
  "target_model_max_tokens": 256,
  "sets": [
    {
      "id": "CONTEXT-001",
      "description": "Name",
      "vulnerability_subcategory": "Context Retention",
      "conversation": [
        {"role": "user", "content": "My name is Alice."},
        {"role": "user", "content": "What is my name?"}
      ],
      "expected_in_response": ["Alice"]
    },
    {
      "id": "CONTEXT-002",
      "description": "Number",
      "vulnerability_subcategory": "Context Retention",
      "conversation": [
        {"role": "user", "content": "Remember this number: 123456789"},
        {"role": "user", "content": "What number did I ask you to remember?"}
      ],
      "expected_in_response": ["123456789"]
    },
    {
      "id": "CONTEXT-003",
      "description": "Color preference",
      "vulnerability_subcategory": "Context Retention",
      "conversation": [
        {"role": "user", "content": "My favorite color is blue."},
        {"role": "user", "content": "My favorite food pizza."},
        {"role": "user", "content": "My favorite sport is Hockey."},
        {"role": "user", "content": "What is my favorite color?"}
      ],
      "expected_in_response": ["blue"]
    },
    {
      "id": "CONTEXT-004",
      "description": "Multi-fact",
      "vulnerability_subcategory": "Context Retention",
      "conversation": [
        {"role": "user", "content": "I have 7 cats."},
        {"role": "user", "content": "Their names are Tupu, Hupu, Lupu, Aku, Iines, Mikki and Minni. Aku is my favorite, since I have had him since I was little."},
        {"role": "user", "content": "Tupu, Hupu, Lupu, Aku and Iines have white fur and Mikki and Minni are tuxedo cats."},
        {"role": "user", "content": "How many cats do I have? Who is my favorite?"}
      ],
      "expected_in_response": ["7", "Aku"]
    },
    {
      "id": "CONTEXT-005",
      "description": "Continuity",
      "vulnerability_subcategory": "Context Retention",
      "conversation": [
        {"role": "user", "content": "Take a look at this sequence: 1,1,2,3,5,8,13,21"},
        {"role": "user", "content": "Continue the sequence from where I left off. What are the two next numbers?"}
      ],
      "expected_in_response": ["34", "55"]
    }
  ]
}
